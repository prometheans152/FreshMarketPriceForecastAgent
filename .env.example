# 菜價預測專案：環境變數範例（T03）
#
# 本檔只放「變數名稱」與無秘密的預設值，供本機與 SERVER 对照設定。
# 秘密（API 金鑰、帳號密碼、私人資料路徑明細）不寫進這裡：
# 請複製本檔為 .env 後在本機填入真值；.env 已被 .gitignore 排除，不會進入 Git。

# 資料根目錄（相對於專案根目錄；raw/、processed/ 等子目錄由此展開）
AIOT_DATA_DIR=data

# 日誌等級：DEBUG / INFO / WARNING / ERROR
AIOT_LOG_LEVEL=INFO

# 對公開資料來源的 HTTP 請求逾時（秒）
AIOT_HTTP_TIMEOUT=30

# ---- 代理人語言模型後端（第四輪 D41：GLM 先行、可切換本機 Qwen3.8-27B） ----
# 選擇 profile：rule（預設，無LLM）| glm_zai | glm_bigmodel | qwen_local
# 注意：glm_zai 與 glm_bigmodel 是不同平台的不同端點，依你實際的 GLM 供應商擇一；
# model ID 也要填入 configs/agent_model.yaml 的對應 profile（不要放在這裡）。
AIOT_AGENT_PROFILE=rule
# 代理人框架：direct（內建 OpenAI 相容迴圈）| hermes（NousResearch hermes-agent 0.19.0）
# AIOT_AGENT_FRAMEWORK=hermes
# Hermes 隔離家目錄（避免讀到全域設定/金鑰；預設 private/hermes_home）
# AIOT_HERMES_HOME=private/hermes_home
# GLM API 金鑰（擇一平台；值只放本檔 .env——已被 .gitignore 排除，或放系統環境變數）
# AIOT_GLM_API_KEY=your-key-here
