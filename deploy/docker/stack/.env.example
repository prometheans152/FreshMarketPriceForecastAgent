# Single-user local default (no TLS). Never expose HTTP to public networks.
FMPA_BIND_ADDRESS=127.0.0.1
FMPA_HTTP_PORT=8080
FMPA_PUBLIC_ORIGIN=http://localhost:8080

# Two separate secrets: backend-origin and MCP-client Bearer.
# For anonymous MCP behind your own HTTPS edge + quotas, set public_noauth.
FMPA_MCP_AUTH_MODE=bearer

# For the optional HTTPS Caddy profile: point your own DNS name at the host.
# FMPA_PUBLIC_DOMAIN=your-domain.example
