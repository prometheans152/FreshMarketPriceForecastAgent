[Unit]
Description=Persist only FMPA HTTP-01 and HTTPS iptables ingress rules
After=network-online.target
Wants=network-online.target
Before=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fresh-market-price-agent-origin-firewall.sh ensure
ExecStop=/usr/local/sbin/fresh-market-price-agent-origin-firewall.sh remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
