[Unit]
Description=Renew TW01 Let's Encrypt short-lived IP certificate and reload Nginx
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/tw01-forecastengine/acme-venv/bin/certbot renew --non-interactive --quiet --deploy-hook "/usr/bin/systemctl reload nginx"
TimeoutStartSec=900
