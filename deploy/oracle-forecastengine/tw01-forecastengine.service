[Unit]
Description=TW01 ForecastEngine A-only private ASGI origin
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=tw01forecast
Group=tw01forecast
WorkingDirectory=/opt/tw01-forecastengine/current
EnvironmentFile=/etc/tw01-forecastengine/origin.env
Environment=PYTHONPATH=/opt/tw01-forecastengine/current/src
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/opt/tw01-forecastengine/venv/bin/python -m uvicorn forecastengine_api:app --app-dir /opt/tw01-forecastengine/current/deploy/oracle-forecastengine --host 127.0.0.1 --port 8767 --workers 1 --no-access-log --log-level warning --timeout-keep-alive 4
Restart=on-failure
RestartSec=4s
TimeoutStartSec=60
TimeoutStopSec=15
UMask=0077
CPUQuota=100%
MemoryHigh=550M
MemoryMax=750M
MemorySwapMax=512M
TasksMax=80
LimitNOFILE=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
