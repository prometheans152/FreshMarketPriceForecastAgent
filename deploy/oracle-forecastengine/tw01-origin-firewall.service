[Unit]
Description=Persist only TW01 HTTP-01 and HTTPS iptables ingress rules
After=network-online.target
Wants=network-online.target
Before=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tw01-origin-firewall.sh ensure
ExecStop=/usr/local/sbin/tw01-origin-firewall.sh remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
